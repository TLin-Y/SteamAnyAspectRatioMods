{
  "name": "any-aspect-ratio-decky",
  "version": "0.1.0",
  "private": true,
  "description": "Decky plugin for managing AnyAspectRatio game fixes",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "build": "rollup -c",
    "test:backend": "python -m unittest discover -s test -v",
    "typecheck": "tsc --noEmit"
  },
  "license": "MIT",
  "devDependencies": {
    "@decky/rollup": "1.0.2",
    "@decky/ui": "4.11.0",
    "@rollup/rollup-linux-x64-musl": "4.53.3",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "@types/react-router": "5.1.20",
    "@types/webpack": "5.28.5",
    "rollup": "4.53.3",
    "typescript": "5.6.2"
  },
  "dependencies": {
    "@decky/api": "1.1.3",
    "tslib": "2.7.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  }
}
