{
  "compilerOptions": {
    "module": "ESNext",
    "target": "ES2020",
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "typeRoots": ["./node_modules/@types"],
    "baseUrl": ".",
    "paths": {
      "@decky/ui": ["src/decky-ui.tsx"],
      "@decky/api": ["src/decky-api.ts"],
      "react": ["node_modules/@types/react"],
      "react/*": ["node_modules/@types/react/*"]
    }
  },
  "include": ["src"]
}
